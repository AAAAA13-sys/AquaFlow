# Copy this file to `.env` and fill in the secrets before running Docker Compose.
# `.env` is gitignored - never commit real credentials.

# Generate with:  docker compose run --rm app php artisan key:generate --show
APP_NAME=AquaFlow
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Manila

# Tier 4 - MySQL root password (required by Docker Compose)
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_DATABASE=aquaflow_db

# Host ports
AQUAFLOW_HTTP_PORT=8080
AQUAFLOW_DB_PORT=3307

# Tier 3 - analytics window
# Enable synthetic presentation forecasts with ANALYTICS_DEMO=true.
ANALYTICS_DEMO=false
ANALYTICS_HISTORY_DAYS=90
ANALYTICS_HORIZON_DAYS=7
ANALYTICS_TIMEOUT=240

# Configure separately for each store; never distribute real credentials.
# NOTE: owner sign-in emails a one-time code, so MAIL_MAILER=smtp is
# effectively required for the owner portal. Until it is configured the
# login page explains which values are missing instead of failing silently.
# Verify with: php artisan aquaflow:mail-test
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=AquaFlow
